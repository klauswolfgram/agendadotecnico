#include 'totvs.ch'
#include 'fwmvcdef.ch'
#include 'tlpp-core.th'

namespace custom.app.agenda.notificacoes

/*/{Protheus.doc} U_BROWSE
    Programa MVC para acompanhamento dos registros de notificacoes registrados na tabela SZ2
    @type  Function
    @author Klaus Wolfgram
    @since 02/03/2026
    @version 1.0

    CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE
    /*/
Function U_BROWSE()
    
    Private aRotina     := u_menudef()
    Private oBrowse     := fwMBrowse():new()
    
    oBrowse:setAlias('SZ2')
    oBrowse:setDescription('Cadastro de Notificações do App')
    oBrowse:setExecuteDef(4)
    
    oBrowse:activate()
    
Return 

Function U_MENUDEF

    Local aRotina := array(0)

    ADD OPTION aRotina TITLE 'Pesquisar' ACTION 'axPesqui'                                       OPERATION 1 ACCESS 0
    ADD OPTION aRotina TITLE 'Visualizar'ACTION 'VIEWDEF.CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE'  OPERATION 2 ACCESS 0 
    ADD OPTION aRotina TITLE 'Incluir'   ACTION 'VIEWDEF.CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE'  OPERATION 3 ACCESS 0
    ADD OPTION aRotina TITLE 'Alterar'   ACTION 'VIEWDEF.CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE'  OPERATION 4 ACCESS 0
    ADD OPTION aRotina TITLE 'Excluir'   ACTION 'VIEWDEF.CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE'  OPERATION 5 ACCESS 0
    ADD OPTION aRotina TITLE 'Imprimir'  ACTION 'VIEWDEF.CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE'  OPERATION 8 ACCESS 0
    ADD OPTION aRotina TITLE 'Copiar'    ACTION 'VIEWDEF.CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE'  OPERATION 9 ACCESS 0

Return aRotina

/*/{Protheus.doc} MODELDEF
    (long_description)
    /*/
Function U_MODELDEF()
    
    Local oModel
    Local oStruct
    Local bModelPre := {|x| fnModPre(x)}
    Local bModelPos := {|x| fnModPos(x)}
    Local bCommit   := {|x| fnCommit(x)}
    Local bCancel   := {|x| fnCancel(x)}
    
    Local bFieldPre := {|oSubModel,cIdAction,cIdField,xValue| fnFieldPre(oSubModel,cIdAction,cIdField,xValue)}
    Local bFieldPos := {|oSubModel|                           fnFieldPos(oSubModel)}
    Local bFieldLoad:= {|oSubModel,lCopy|                     fnFieldLoad(oSubModel,lCopy)}

    oStruct         := fwFormStruct(1,'SZ2')    
    oModel          := mpFormModel():new('MODEL_NOTIFICACOES',bModelPre,bModelPos,bCommit,bCancel)

    oModel:addFields('SZ2MASTER',,oStruct,bFieldPre,bFieldPos,bFieldLoad)
    oModel:setDescription('NOTIFICACOES')
    oModel:setPrimaryKey({'Z2_FILIAL','Z2_ID'})
    
Return oModel

/*/{Protheus.doc} VIEWDEF
(long_description)
/*/
Function U_VIEWDEF()

    Local oView
    Local oModel
    Local oStruct

    oStruct         := fwFormStruct(2,'SZ2')
    oModel          := fwLoadModel('CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE')//fwModelActive()
    oView           := fwFormView():new()

    oView:setModel(oModel)
    oView:addField('SZ2MASTER',oStruct,'SZ2MASTER')
    oView:createHorizontalBox('BOXSZ2',100)
    oView:setOwnerView('SZ2MASTER','BOXSZ2')
    
Return oView

