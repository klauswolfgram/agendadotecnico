/*/{Protheus.doc} U_INCLUIR
    Funcao para incluir nova notificacao
    @type  Function
    @author Klaus Wolfgram
    @since 02/03/2026
    @version 1.0

    custom.app.agenda.notificacoes.u_incluir(cTecnico,cOrigem,cTitulo,cMensagem,cLink)
    /*/
Function U_INCLUIR(cTecnico as Character, cOrigem as Character,cTitulo as Character,cMensagem as Character,cLink as Character) as Logical

    Local oModel    as Object
    Local lret      as Logical
    Local cNomeTec  as Character
    Local cDataHr   as Character

    IF AA1->(dbSetOrder(1),dbSeek(xFilial(alias())+cTecnico))
        cNomeTec    := AA1->AA1_NOMTEC
    EndIF

    cDataHr         := DTOC(date()) + ' ' + LEFT(time(),5)

    oModel          := fwLoadModel('CUSTOM.APP.AGENDA.NOTIFICACOES.BROWSE')

    oModel:setOperation(MODEL_OPERATION_INSERT)
    oModel:activate()
    
    oModel:getModel('SZ2MASTER'):setValue('Z2_TECNICO',LEFT(cTecnico ,tamSX3('Z2_TECNICO')[1]))
    oModel:getModel('SZ2MASTER'):setValue('Z2_NOMETEC',LEFT(cNomeTec ,tamSX3('Z2_NOMETEC')[1]))
    oModel:getModel('SZ2MASTER'):setValue('Z2_ORIGEM' ,LEFT(cOrigem  ,tamSX3('Z2_ORIGEM' )[1]))
    oModel:getModel('SZ2MASTER'):setValue('Z2_TITULO' ,LEFT(cTitulo  ,tamSX3('Z2_TITULO' )[1]))
    oModel:getModel('SZ2MASTER'):setValue('Z2_TEXTO'  ,LEFT(cMensagem,tamSX3('Z2_TEXTO'  )[1]))
    oModel:getModel('SZ2MASTER'):setValue('Z2_LINK'   ,LEFT(cLink    ,tamSX3('Z2_LINK'   )[1]))
    oModel:getModel('SZ2MASTER'):setValue('Z2_DATAHR' ,LEFT(cDataHr  ,tamSX3('Z2_DATAHR' )[1]))

    IF oModel:vlddata()
        oModel:commitdata()
        lret     := .T.
    Else
        xError   := oModel:getErrorMessage()
        fwAlertError(if(valtype(xError) == 'A',xError[6],'erro ao incluir notificacao'))
    EndIF

    oModel:deactivate()
    oModel:destroy()
    
Return lret
 
